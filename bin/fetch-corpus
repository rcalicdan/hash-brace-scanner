#!/usr/bin/env php
<?php

declare(strict_types=1);

define('TYPEPHP_DISABLE', true);

require __DIR__ . '/../vendor/autoload.php';

use HashBraceScanner\Fetch\Fetcher;
use function Rcalicdan\ConfigLoader\env;

$count = (int) env('FETCH_COUNT', 500);

$options = [
    'concurrency' => (string) env('FETCH_CONCURRENCY', '8'),
    'workers'     => (string) env('FETCH_WORKERS', '4'),
    'target'      => (string) env('FETCH_TARGET', __DIR__ . '/../corpus'),
    'report'      => (string) env('FETCH_REPORT', __DIR__ . '/../reports/fetch-report.json'),
];

foreach (array_slice($argv, 1) as $arg) {
    if (preg_match('/^--([a-z-]+)=(.+)$/', $arg, $m) === 1 && array_key_exists($m[1], $options)) {
        $options[$m[1]] = $m[2];
    } elseif (ctype_digit($arg)) {
        $count = (int) $arg;
    } else {
        fwrite(STDERR, "Unknown argument: {$arg}\n");
        fwrite(STDERR, "Usage: php bin/fetch-corpus [count] [--concurrency=8] [--workers=4] [--target=corpus] [--report=reports/fetch-report.json]\n");
        exit(1);
    }
}

$concurrency = max(1, (int) $options['concurrency']);
$workers     = max(1, (int) $options['workers']);

$token = env('GITHUB_TOKEN') ?: null;

if ($token === null) {
    fwrite(STDERR, "Note: GITHUB_TOKEN is not set in .env or environment. Large runs may hit rate limits.\n");
}

@mkdir($options['target'], 0777, true);
@mkdir(dirname($options['report']), 0777, true);

$fetcher = new Fetcher($options['target'], $concurrency, $token, $workers);

$names = $fetcher->popularPackageNames($count);
if ($names === []) {
    fwrite(STDERR, "Could not read the popular package list from Packagist.\n");
    exit(1);
}
fwrite(STDERR, sprintf("%d packages to fetch (HTTP concurrency: %d, CPU workers: %d)\n", count($names), $concurrency, $workers));

$report = $fetcher->fetchAll($names, function (int $done, int $total) {
    if ($done % 25 === 0 || $done === $total) {
        fwrite(STDERR, "{$done}/{$total} processed\n");
    }
});

file_put_contents($options['report'], json_encode($report->toArray(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");

fwrite(STDERR, sprintf("Fetched %d of %d packages into %s\n", $report->succeeded(), $report->requested, $options['target']));
foreach ($report->failuresByReason() as $reason => $n) {
    fwrite(STDERR, "  {$reason}: {$n}\n");
}
if ($report->hasRateLimitFailures()) {
    fwrite(STDERR, "Rate limited: check your GITHUB_TOKEN in .env and run again.\n");
}
fwrite(STDERR, "Report written to {$options['report']}\n");

exit($report->succeeded() > 0 ? 0 : 1);