#!/usr/bin/env php
<?php

declare(strict_types=1);

define('TYPEPHP_DISABLE', true);

require __DIR__ . '/../vendor/autoload.php';

use HashBraceScanner\Scanner;
use Hibla\Parallel\ProcessPool;
use Hibla\Parallel\Utilities\SystemUtilities;
use Hibla\Promise\Promise;
use function Hibla\await;

$directories = [];
$outputFile = null;
$concurrency = SystemUtilities::getCpuCount() - 2; 

foreach (array_slice($argv, 1) as $arg) {
    if (str_starts_with($arg, '--output=')) {
        $outputFile = substr($arg, 9);
    } elseif (preg_match('/^--concurrency=(\d+)$/', $arg, $m) === 1) {
        $concurrency = (int) $m[1];
    } elseif (!str_starts_with($arg, '-')) {
        $directories[] = $arg;
    }
}

if ($directories === []) {
    fwrite(STDERR, "Usage: bin/scan <dir> [<dir> ...] [--concurrency=8] [--output=reports/report.json]\n");
    fwrite(STDERR, "       bin/scan <dir> > reports/report.json\n");
    exit(1);
}

foreach ($directories as $dir) {
    if (!is_dir($dir)) {
        fwrite(STDERR, "Not a directory: {$dir}\n");
        exit(1);
    }
}

fwrite(STDERR, "Discovering PHP files in: " . implode(', ', $directories) . "...\n");
$files = [];

foreach ($directories as $dir) {
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($dir, FilesystemIterator::SKIP_DOTS)
    );
    foreach ($iterator as $file) {
        if ($file->isFile() && $file->getExtension() === 'php') {
            $files[] = $file->getPathname();
        }
    }
}

$totalFiles = count($files);
fwrite(STDERR, sprintf("Found %s PHP files. Scanning across %d CPU workers...\n", number_format($totalFiles), $concurrency));

if ($totalFiles === 0) {
    $emptyReport = (new Scanner())->report();
    echo json_encode($emptyReport, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n";
    exit(0);
}

$chunkSize = 500;
$chunks = array_chunk($files, $chunkSize);

$pool = new ProcessPool(size: $concurrency);
$masterScanner = new Scanner();

$startTime = microtime(true);
$scannedCount = 0;

try {
    $results = await(Promise::mapSettled(
        $chunks,
        function (array $chunk) use ($pool, &$scannedCount, $totalFiles, $startTime): array {
    
            $chunkReport = await($pool->run(static function () use ($chunk): array {
                $scanner = new Scanner();
                foreach ($chunk as $file) {
                    $scanner->scanFile($file);
                }
                return $scanner->report();
            }));

            $scannedCount += count($chunk);

            $elapsed = max(0.001, microtime(true) - $startTime);
            $rate = (int) ($scannedCount / $elapsed);
            $percent = (int) (($scannedCount / $totalFiles) * 100);

            fwrite(
                STDERR,
                sprintf(
                    "\r  [%3d%%] Scanned: %s / %s (%s files/s)   ",
                    $percent,
                    number_format($scannedCount),
                    number_format($totalFiles),
                    number_format($rate)
                )
            );

            return $chunkReport;
        },
        concurrency: $concurrency
    ));

    foreach ($results as $result) {
        if ($result->isFulfilled()) {
            $masterScanner->merge($result->value);
        }
    }
} finally {
    $pool->shutdown();
}

$elapsed = max(0.001, microtime(true) - $startTime);
$report = $masterScanner->report();
$stats = $report['stats'];
$scannedTotal = $stats['files_scanned'];
$rate = (int) ($scannedTotal / $elapsed);

fwrite(STDERR, "\r" . str_repeat(' ', 70) . "\r");
fwrite(STDERR, sprintf("✓ Completed scan of %s files in %.2fs (%s files/s)\n\n", number_format($scannedTotal), $elapsed, number_format($rate)));
fwrite(STDERR, "  Summary:\n");
fwrite(STDERR, sprintf("  • Files with hits: %d\n", $stats['files_with_hits']));
fwrite(STDERR, sprintf("  • Breaking hits:   %d\n", $stats['breaking_hits']));
fwrite(STDERR, sprintf("  • Unterminated:    %d\n", $stats['hits']['unterminated']));
fwrite(STDERR, sprintf("  • Trailing code:   %d\n", $stats['hits']['trailing_code']));
fwrite(STDERR, sprintf("  • Clean hits:      %d\n", $stats['hits']['clean']));
fwrite(STDERR, "\n");

$json = json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n";

if ($outputFile !== null) {
    @mkdir(dirname($outputFile), 0777, true);
    file_put_contents($outputFile, $json);
    fwrite(STDERR, "Report written to {$outputFile}\n");
} else {
    echo $json;
}